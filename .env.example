SIGNALIBRIUM_MARKET_DATA_PROVIDER=ig
SIGNALIBRIUM_CHART_VENDOR=embed
SIGNALIBRIUM_IG_ENVIRONMENT=demo
SIGNALIBRIUM_IG_API_KEY=your_ig_api_key
SIGNALIBRIUM_IG_IDENTIFIER=your_demo_username
SIGNALIBRIUM_IG_PASSWORD=your_demo_password
SIGNALIBRIUM_IG_ACCOUNT_ID=your_demo_account_id

# These IG credentials are currently used for market data only.
# The execution desk has been simplified toward Interactive Brokers,
# but the real IBKR order-routing connector is not wired yet.

# To enable the full licensed TradingView Charting Library workspace, set:
# SIGNALIBRIUM_CHART_VENDOR=charting_library
# Then place the licensed library bundle at:
# public/charting_library/charting_library.js

# Optional explicit market epic overrides if IG search results do not match your intended instrument.
# SIGNALIBRIUM_IG_EPIC_LINK=
# SIGNALIBRIUM_IG_EPIC_ONDO=
# SIGNALIBRIUM_IG_EPIC_RENDER=
# SIGNALIBRIUM_IG_EPIC_AKT=
# SIGNALIBRIUM_IG_EPIC_AINF=
# SIGNALIBRIUM_IG_EPIC_NUKZ=
# SIGNALIBRIUM_IG_EPIC_URA=
# SIGNALIBRIUM_IG_EPIC_TKNX=

# Optional explicit Coinbase Exchange product overrides for crypto symbols.
# The app now prefers Coinbase's public WebSocket + official candles for crypto,
# and falls back to CoinGecko only when Coinbase does not list the product.
# SIGNALIBRIUM_COINBASE_PRODUCT_LINK=LINK-USD
# SIGNALIBRIUM_COINBASE_PRODUCT_BTC=BTC-USD
# SIGNALIBRIUM_COINBASE_PRODUCT_ETH=ETH-USD

# Optional explicit Kraken pair overrides for crypto symbols.
# Kraken is used as a secondary official crypto rail when Coinbase does not
# provide a clean USD market for a tracked token.
# SIGNALIBRIUM_KRAKEN_PAIR_TRX=TRXUSD
# SIGNALIBRIUM_KRAKEN_PAIR_LINK=LINKUSD

# Optional explicit Bybit spot symbol overrides for the remaining long-tail
# crypto names that are not covered cleanly by Coinbase or Kraken.
# Bybit is only used as a narrow tertiary exchange rail before falling back
# to CoinGecko.
# SIGNALIBRIUM_BYBIT_SYMBOL_SUI=SUIUSDT
# SIGNALIBRIUM_BYBIT_SYMBOL_JUP=JUPUSDT
# SIGNALIBRIUM_BYBIT_SYMBOL_ENA=ENAUSDT

# Optional explicit KuCoin spot symbol overrides for the final uncovered
# crypto names that still need an official exchange-native backup path.
# SIGNALIBRIUM_KUCOIN_SYMBOL_AKT=AKT-USDT
