# ─────────────────────────────────────────────────────────────────────────────
# Signalibrium — Environment Variables
#
# Copy this file to .env.local for local development.
# All production values are set in the Vercel dashboard under
# Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Upstash Redis  (required in production) ──────────────────────────────────
# Vercel KV / Upstash Redis — the only durable store in production.
# Create a free database at https://upstash.com then copy the REST credentials.
# Vercel KV auto-injects KV_REST_API_URL / KV_REST_API_TOKEN if you link the
# integration; otherwise set the Upstash variants below.
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# ─── Clerk Auth  (required) ───────────────────────────────────────────────────
# Create an application at https://dashboard.clerk.com
# Use the "test" keys for development, "live" keys for production.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ─── Anthropic  (required) ────────────────────────────────────────────────────
# Powers Siggi's chat panel and the AI opportunity-analysis pipeline.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# ─── Vercel Cron Secret  (set automatically by Vercel) ────────────────────────
# Vercel injects CRON_SECRET automatically when you deploy with crons configured
# in vercel.json.  You do NOT need to set this manually — Vercel handles it.
# It is listed here only so local testing of /api/cron/sync works without auth.
# CRON_SECRET=

# ─── Stripe Billing  (optional — billing page disabled without these) ─────────
# Get from https://dashboard.stripe.com → Developers → API Keys
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# Webhook: Stripe → Developers → Webhooks → Add endpoint → POST /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs from your Stripe product catalogue (Dashboard → Products)
STRIPE_PRO_PRICE_ID=price_...
STRIPE_ALGO_PRICE_ID=price_...

# ─── Telegram Alerts  (optional — Siggi trade notifications) ─────────────────
# 1. Message @BotFather on Telegram → /newbot → copy the token below
# 2. Message your new bot, then open in browser:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    Copy the "id" value from chat.id
# 3. Test the connection: POST https://your-app.vercel.app/api/notifications/telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Algo Signal API  (optional — /api/signals disabled without this) ─────────
# Share this secret only with Algo-plan subscribers via their dashboard.
# Generate a strong value with:  openssl rand -hex 32
SIGNAL_API_SECRET=your-secret

# ─── Broker OAuth  (required for broker connections without manual API keys) ──
# Register your app at the broker's developer portal to get client_id + secret.
#
# Alpaca:
#   1. Go to https://app.alpaca.markets/developer/apps → Create new app
#   2. Set redirect URI to:  {NEXT_PUBLIC_APP_URL}/api/broker-connections/oauth/callback
#   3. Copy client_id and client_secret below
ALPACA_OAUTH_CLIENT_ID=
ALPACA_OAUTH_CLIENT_SECRET=
#
# OANDA:
#   1. Go to https://developer.oanda.com → Register application
#   2. Set redirect URI to:  {NEXT_PUBLIC_APP_URL}/api/broker-connections/oauth/callback
#   3. Copy client_id and client_secret below
OANDA_OAUTH_CLIENT_ID=
OANDA_OAUTH_CLIENT_SECRET=

# ─── Affiliate Broker Button  (optional — hidden without REFERRAL_URL) ────────
NEXT_PUBLIC_BROKER_NAME=Trade Nation
NEXT_PUBLIC_BROKER_REFERRAL_URL=https://tradenation.com/en-gb/?ref=signalibrium

# ─── App URL  (used by Stripe redirect URLs) ──────────────────────────────────
NEXT_PUBLIC_APP_URL=https://signalibrium.vercel.app
