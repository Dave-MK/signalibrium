# ─── Upstash Redis (required in production) ───────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# ─── Clerk Auth (required) ────────────────────────────────────────────────────
# Get from: https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ─── Stripe Billing (optional — billing page disabled without these) ──────────
# Get from: https://dashboard.stripe.com → Developers → API Keys
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# Webhook: Stripe → Developers → Webhooks → Add endpoint → POST /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs from your Stripe product catalogue
STRIPE_PRO_PRICE_ID=price_...
STRIPE_ALGO_PRICE_ID=price_...

# ─── Algo Signal API (optional — /api/signals disabled without this) ──────────
# Share this secret only with Algo plan subscribers via their dashboard
# Generate with: openssl rand -hex 32
SIGNAL_API_SECRET=your-secret

# ─── Affiliate Broker Button (optional — hidden without REFERRAL_URL) ─────────
NEXT_PUBLIC_BROKER_NAME=Trade Nation
NEXT_PUBLIC_BROKER_REFERRAL_URL=https://tradenation.com/en-gb/?ref=signalibrium

# ─── App URL (used by Stripe redirect URLs) ───────────────────────────────────
NEXT_PUBLIC_APP_URL=https://signalibrium.vercel.app
